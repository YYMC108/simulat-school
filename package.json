{
  "name": "campus-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "大学生活模拟器 —— 数据驱动的文字养成游戏引擎",
  "scripts": {
    "play": "tsx src/cli/play.ts",
    "simulate": "tsx src/cli/simulate.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "measure:layout": "node scripts/measure-layout.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preflight": "powershell -ExecutionPolicy Bypass -NoProfile -File scripts/preflight.ps1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
